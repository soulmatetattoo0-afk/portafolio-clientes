# Copy to .env.local. Every service is optional: leave a group empty and the
# app uses its local stand-in (embedded Postgres, demo login, files on disk,
# simulated deposits, email log). The UI shows a demo banner while any core
# service (database, auth, payments) is simulated.

# Public URL of the app, no trailing slash (used in emails and Stripe redirects).
APP_URL=http://localhost:3000
# Long random string: signs file URLs, upload tokens and calendar feeds.
APP_SECRET=

# Supabase: database (use the "Transaction pooler" connection string), auth and storage.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (platform account). Webhook endpoint: /api/stripe/webhook, events on connected accounts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional platform fee on deposits in basis points (300 = 3%). Keep 0 on subscription plans.
PLATFORM_FEE_BPS=0

# Resend for email.
RESEND_API_KEY=
EMAIL_FROM="Brief <bookings@yourdomain.com>"

# Founding phase: only these emails can create an artist page (comma-separated). Empty = anyone.
ALLOWED_SIGNUPS=

# Protects /api/cron/outbox (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
