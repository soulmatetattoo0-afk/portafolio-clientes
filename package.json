{
  "name": "ink-brief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "mannequin:build": "python tools/mannequin/build.py --out public/mannequin && npm run mannequin:compress",
    "mannequin:compress": "for b in f m; do gltf-transform meshopt public/mannequin/body-$b.glb public/mannequin/body-$b.glb --level medium; done"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "stripe": "^23.0.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2"
  }
}
